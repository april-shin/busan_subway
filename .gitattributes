# 텍스트 파일은 LF로 정규화
* text=auto eol=lf

# 명시적 이진 파일
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.so binary
*.dylib binary
*.dll binary

# Windows 배치 파일만 CRLF 허용
*.bat text eol=crlf

# 외부 원본 데이터는 바이트 그대로 보존 (CP949 인코딩 + CRLF).
# 인천교통공사 열차운행시각표 CSV — 재수집 시 원본과 diff 비교가 가능해야 한다.
tool/data/incheon1/*.csv -text
